# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Mithaq

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Prisma / Supabase Postgres)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
CSRF_SECRET=change-me-to-another-long-random-secret

# OAuth (configure in Supabase dashboard)
# Google / Apple providers enabled via Supabase Auth

# Optional moderation / AI
OPENAI_API_KEY=
MODERATION_ENABLED=true

# Free tier limits
FREE_DAILY_LIKES=10
FREE_MAX_MATCHES=5
